{
  "time": {
    "type": "stdio",
    "command": "uvx",
    "args": ["mcp-server-time"],
    "env": {}
  },
  "obsidian": {
    "type": "http",
    "url": "http://127.0.0.1:27123/mcp/",
    "headers": {
      "Authorization": "Bearer ${OBSIDIAN_API_KEY}"
    }
  },
  "linear": {
    "type": "http",
    "url": "https://mcp.linear.app/mcp"
  },
  "bot-dataverse": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/uv",
    "args": ["run", "--directory", "${HOME}/projects/bot-dataverse", "python", "-m", "bot_dataverse"],
    "env": {}
  },
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@latest"],
    "env": {}
  },
  "microsoft-learn": {
    "type": "http",
    "url": "https://learn.microsoft.com/api/mcp"
  }
}
